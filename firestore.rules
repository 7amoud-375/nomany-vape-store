rules_version = '2';

// ---------------------------------------------------------------------------
// Nomany Store — security rules.
//
// Model: there are no customer accounts. Checkout is guest-only, and the only
// account that exists is the admin's.
//
// The critical detail: nothing here trusts "is signed in" as a proxy for "is
// admin". Email/Password sign-up stays enabled at the Firebase API level even
// with no sign-up form on the site, so anyone can still mint an account. Admin
// is proven by reading the user's own document and checking role == 'admin'.
//
// Deploy:  firebase deploy --only firestore:rules
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // -- Admin accounts ------------------------------------------------------
    // Readable and writable by nobody through the client. The admin document is
    // created by hand in the Firebase console; leaving any write path open here
    // is exactly how a customer promotes themselves to admin.
    //
    // Read is limited to the signed-in user's OWN document because the app has
    // to look up its own role after login.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow write: if false;
    }

    // -- Storefront catalogue ------------------------------------------------
    // Public read (it is a shop). Admin-only write.
    match /store/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -- Orders --------------------------------------------------------------
    // Guests place orders, so create is open — but constrained: an order may
    // only be created in an unpaid state, so nobody can submit one already
    // marked paid. Reading the collection is admin-only; without that, one
    // signed-in user could dump every customer's name, phone and address.
    match /orders/{orderId} {
      allow create: if request.resource.data.status in ['pending', 'awaiting_payment'];
      allow read, update, delete: if isAdmin();
    }

    // -- "Notify me when back in stock" --------------------------------------
    match /stockNotifications/{docId} {
      allow create: if request.resource.data.notified == false;
      allow read, update, delete: if isAdmin();
    }

    // -- Server-verified payments -------------------------------------------
    // Written only by the payment callback using a service account. Denying the
    // browser entirely is what makes a "paid" status trustworthy.
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny everything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
