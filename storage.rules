rules_version = '2';

// ---------------------------------------------------------------------------
// Nomany Store — Firebase Storage rules.
//
// Product images are public to read (the shop displays them to signed-out
// visitors) and admin-only to write.
//
// Deploy:  firebase deploy --only storage
// ---------------------------------------------------------------------------

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /products/{imageId} {
      allow read: if true;

      // Size and type are enforced here as well as in the client: the uploader
      // compresses before sending, but nothing stops a crafted request.
      allow write: if isAdmin()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
