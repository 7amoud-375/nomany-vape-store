# ---------------------------------------------------------------------------
# API routing and protection.
# ---------------------------------------------------------------------------

# Never serve secrets, the database config, or anything in the data store.
<FilesMatch "^\.|\.(env|ini|log|json|md|sql|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # Apache with mod_php drops the Authorization header unless it is passed
    # through explicitly — without this every admin request looks signed-out.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Real files (upload.php, callback.php) are served directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else is handled by the front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>
