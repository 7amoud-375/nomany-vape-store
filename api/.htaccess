# ---------------------------------------------------------------------------
# Protect secrets and internal data.
#
# Apache 2.4 uses `Require all denied`; 2.2 uses `Order allow,deny`. The
# <IfModule> guards pick the right one so this file is safe on either.
# ---------------------------------------------------------------------------

# Never serve dotfiles, env files, or anything in the data store.
<FilesMatch "^\.|\.(env|ini|log|json|md|sql|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# No directory listings.
Options -Indexes

# Do not leak the PHP version in response headers.
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
