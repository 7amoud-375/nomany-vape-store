; Copy to api/.env and fill in. Never web-readable — api/.htaccess denies it,
; and it stays out of version control.
;
; Keep every value inside double quotes: parse_ini_file treats ; and # as
; comment characters, so an unquoted password containing one is silently
; truncated and the only symptom is a connection failure.

; ---------------------------------------------------------------------------
; Database — hPanel -> Databases -> MySQL Databases
; One database is enough; the Single plan's allowance covers it.
; ---------------------------------------------------------------------------
DB_HOST = "localhost"
DB_NAME = ""
DB_USER = ""
DB_PASS = ""

; ---------------------------------------------------------------------------
; Security
; ---------------------------------------------------------------------------
; Signs admin sessions. At least 32 characters — the API refuses to start
; without it rather than falling back to something guessable.
; Generate one:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET = ""

; The first admin, created automatically on first boot if no account exists.
; Delete these two lines once you have signed in successfully.
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = ""

; ---------------------------------------------------------------------------
; Site
; ---------------------------------------------------------------------------
APP_ALLOWED_ORIGINS = "https://nomany-vape-store.com,https://www.nomany-vape-store.com,http://localhost:5173"
; Leave blank. Uploads are served from the same origin as the site, so the API
; returns root-relative paths like /uploads/x.jpg — those work on localhost,
; on www and non-www, and before the certificate is issued. Only set this if
; images are deliberately served from a separate host such as a CDN.
UPLOAD_PUBLIC_URL = ""
STORE_TIMEZONE = "Africa/Cairo"

; ---------------------------------------------------------------------------
; Payments
; ---------------------------------------------------------------------------
; No gateway, no keys here. The shop takes cash on delivery plus manual
; InstaPay / Vodafone Cash transfers — the customer sends the money
; themselves and a receipt over WhatsApp. The transfer number/link for each
; is edited from Dashboard -> Settings -> Payment, not here.

; ---------------------------------------------------------------------------
; One-off Firestore import (api/migrate-from-firestore.php)
; ---------------------------------------------------------------------------
; The script is no longer deployed by default. Only set this, and only upload
; the script, if you still need to pull the old Firestore data across. Delete
; both from the server once the import has run and you have checked the data.
; FIREBASE_PROJECT_ID = "nomany-vape-store"
