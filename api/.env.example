; Copy to api/.env and fill in. This file must never be web-readable --
; api/.htaccess denies it, but keep it outside version control regardless.

; ---------------------------------------------------------------------------
; Paymob (dashboard -> Settings -> Account Info, and Developers -> Integrations)
; ---------------------------------------------------------------------------
PAYMOB_API_KEY = ""
PAYMOB_IFRAME_ID = ""
PAYMOB_INTEGRATION_ID_CARD = ""
PAYMOB_INTEGRATION_ID_VODAFONE = ""

; HMAC secret used to sign transaction callbacks. Without this, callback.php
; cannot verify payments and nothing will ever be marked paid.
PAYMOB_HMAC_SECRET = ""

; ---------------------------------------------------------------------------
; Firebase
; ---------------------------------------------------------------------------
; Project id, e.g. "nomany-store". Used to price carts from the live catalogue.
FIREBASE_PROJECT_ID = ""

; Absolute path to a service-account JSON key, used only by callback.php to
; write the verified "paid" status. Generate it at:
;   Firebase console -> Project settings -> Service accounts -> Generate new key
; Store it OUTSIDE the web root, e.g. /home/USER/secrets/firebase-sa.json
FIREBASE_SERVICE_ACCOUNT = ""

; ---------------------------------------------------------------------------
; CORS
; ---------------------------------------------------------------------------
; Comma-separated list of origins allowed to call these endpoints.
APP_ALLOWED_ORIGINS = "https://yourdomain.com,https://www.yourdomain.com,http://localhost:5173"
