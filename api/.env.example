; Copy to api/.env and fill in. Never web-readable — api/.htaccess denies it,
; and it stays out of version control.

; ---------------------------------------------------------------------------
; Database — hPanel -> Databases -> MySQL Databases
; ---------------------------------------------------------------------------
DB_HOST = "localhost"
DB_NAME = ""
DB_USER = ""
DB_PASS = ""

; ---------------------------------------------------------------------------
; Security
; ---------------------------------------------------------------------------
; Signs admin sessions. At least 32 characters — the API refuses to start
; without it rather than falling back to something guessable.
; Generate one:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET = ""

; The first admin, created automatically on first boot if no account exists.
; Delete these two lines once you have signed in successfully.
ADMIN_USERNAME = "nomany"
ADMIN_PASSWORD = ""

; ---------------------------------------------------------------------------
; Site
; ---------------------------------------------------------------------------
APP_ALLOWED_ORIGINS = "https://nomany-vape-store.com,https://www.nomany-vape-store.com,http://localhost:5173"
UPLOAD_PUBLIC_URL = "https://nomany-vape-store.com/uploads"
STORE_TIMEZONE = "Africa/Cairo"

; ---------------------------------------------------------------------------
; Payments
; ---------------------------------------------------------------------------
; 'cod' keeps the shop on cash-on-delivery only. Switch to 'kashier' and fill
; in the block below — no application code changes.
PAYMENT_PROVIDER = "cod"
PAYMENT_CURRENCY = "EGP"

; Where the customer lands after paying, and the server-to-server confirmation
; URL. The webhook must be publicly reachable.
PAYMENT_RETURN_URL = "https://nomany-vape-store.com/checkout?status=return"
PAYMENT_WEBHOOK_URL = "https://nomany-vape-store.com/api/payments/webhook"

; Kashier — from the Kashier dashboard. Set mode to "live" when going live.
KASHIER_MERCHANT_ID = ""
KASHIER_API_KEY = ""
KASHIER_SECRET_KEY = ""
KASHIER_MODE = "test"

; ---------------------------------------------------------------------------
; One-off migration only (api/migrate-from-firestore.php)
; ---------------------------------------------------------------------------
; Remove once the import has run and you have verified the data.
FIREBASE_PROJECT_ID = "nomany-vape-store"
